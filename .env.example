# Copy to .env (gitignored) to override the defaults in test-data/credentials.ts.
# Variables already set in the shell or CI take precedence over this file.
BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
# Shared password shown on the Sauce Demo login page.
SAUCE_PASSWORD=
# Pause between actions in ms, for watching a headed run. 0 = full speed.
SLOW_MO=0
